#!/usr/bin/env python3
"""Speak to a session by name. Terminal input is never part of tandem delivery."""
import argparse
import collections
import json
import os
import re
from pathlib import Path
import secrets
import subprocess
import sys
import time
from tandem_core import (alive, claim_name, claude_processes, revive, host, key, lock, me, path, permission_mode, process, public, read,
                       receipt, root, session, sessions, update_receipt, valid_name, write)
from tandem_delivery import receive, start_worker, work
from tandem_transport import BIN, hosts, inventory, remote


def local_inventory():
    raw = sessions()
    live = claude_processes() if any(r.get('kind') == 'claude' and not alive(r) for r in raw) else {}
    rows = [public(revive(row, live)) for row in raw]
    sockets = {row.get('tmux_socket') for row in rows if str(row.get('target', '')).startswith('%')}
    for sock in sockets:
        if not sock:
            continue
        result = subprocess.run(['tmux', '-S', sock, 'list-panes', '-a', '-F',
                                 '#{pane_id}\t#{session_name}\t#{window_index}\t#{pane_index}'],
                                capture_output=True, text=True, timeout=2)
        places = {}
        for line in result.stdout.splitlines():
            fields = line.split('\t')
            if len(fields) == 4:
                places[fields[0]] = fields[1:]
        for row in rows:
            if row.get('tmux_socket') == sock and row.get('target') in places:
                group, window, pane = places[row['target']]
                row.update(group=group, window=int(window), pane=int(pane))
    for row in rows:
        row.setdefault('group', 'no tmux')
    return rows


def all_agents():
    return inventory(local_inventory())


def resolve(name):
    rows, errors = all_agents()
    if '@' in name:
        name, owner = name.rsplit('@', 1)
        rows = [r for r in rows if r['host'] == owner]
    matches = ([r for r in rows if r['name'] == name]
               or [r for r in rows if name in (r['id'], r.get('session'))])
    if len(matches) > 1:
        # Stopped sessions keep their names for resume; prefer the sole live namesake.
        live = [r for r in matches if r['state'] != 'gone']
        if len(live) == 1:
            return live[0]
    if len(matches) == 1:
        return matches[0]
    if matches:
        raise ValueError('ambiguous name; use ' + ' or '.join(r['id'] + '@' + r['host'] for r in matches))
    raise ValueError('no agent named ' + name + '; run tandem --all' + ('; unreachable: ' + '; '.join(errors) if errors else ''))


def dispatch(owner, request):
    return rpc(request, host()) if owner == host() else remote(owner, request)


def rpc(request, source):
    op = request.get('op')
    if op == 'spawn':
        from tandem_spawn import spawn
        return spawn([request['name'], '--kind', request['kind'], '--cwd', request['cwd'],
                      '--timeout', str(request.get('timeout', 5)), '--'] + request.get('args', []))
    if op == 'list':
        return {'agents': local_inventory()}
    if op == 'receive':
        return receive(request, source)
    if op == 'receipt':
        row = receipt(request['id'])
        if not row:
            raise ValueError('receipt not found on ' + host())
        return row
    if op == 'read':
        from tandem_history import history
        row = session(request['session'])
        if not row:
            raise ValueError('session is not registered; run tandem to see who is there')
        last = request.get('last', 3)
        if not isinstance(last, int) or not 1 <= last <= 10:
            raise ValueError('last must be between 1 and 10')
        return history(row, last)
    raise ValueError('unsupported tandem operation')


def clean(text, limit=90):
    return ' '.join(str(text or '').split())[:limit]


def short_path(path):
    """~ for a home folder on any machine, so lists stay readable (and don't print account names)."""
    return re.sub(r'^(?:/(?:Users|home)/[^/]+(?=/|$)|[A-Za-z]:\\Users\\[^\\]+(?=\\|$))', '~', str(path or ''))


def list_agents(query='', show_all=False, as_json=False):
    rows, errors = all_agents()
    current = me(False)
    own = next((r for r in rows if current and r['id'] == current['id'] and r['host'] == host()), {})
    cwd = own.get('cwd') or os.getcwd()
    contacts = read(root() / 'contacts.json')
    def rank(row):
        same = row['host'] == host() and own.get('group') not in (None, 'no tmux') and row.get('group') == own.get('group')
        try:
            common = os.path.commonpath([cwd, row.get('cwd') or '/'])
        except ValueError:
            common = '/'
        close = common not in ('/', str(Path.home()), str(Path.home().parent)) and (
            common in (cwd, row.get('cwd')) or Path(cwd).parent == Path(row.get('cwd') or '/').parent)
        contact = contacts.get(row['host'] + '/' + row['id'], 0)
        return (0 if same else 1 if close else 2 if contact else 3,
                row['host'], row.get('group', ''), row.get('window', 0), row.get('pane', 0), -contact, row['name'])
    rows.sort(key=rank)
    hidden = []
    if query:
        rows = [r for r in rows if query.casefold() in ' '.join(str(r.get(k) or '') for k in ('name', 'cwd', 'title')).casefold()]
    elif not show_all:
        rows = [r for r in rows if r['state'] != 'gone']  # ended sessions only under --all
        visible = [r for r in rows if rank(r)[0] < 3][:20]
        if not visible:
            visible = rows[:8]
        hidden = [r for r in rows if r not in visible]
        rows = visible
    if as_json:
        return {'agents': rows, 'hidden': len(hidden), 'unreachable': errors}
    group = None
    counts = collections.Counter(r['name'] for r in rows)
    for row in rows:
        new_group = row['host'] + ' / ' + row.get('group', 'Other')
        if new_group != group:
            print(new_group)
            group = new_group
        name = row['name'] + ('@' + row['host'] if counts[row['name']] > 1 else '')
        state = row['state']
        if state == 'waiting-on':
            state += '(' + row['waiting_on'] + ')'
        if state == 'blocked':
            state += '(' + (row.get('reason') or 'user') + ')'
        if state == 'error' and row.get('reason') not in (None, 'app-server', 'turn-failed'):
            state += '(' + clean(row['reason'], 70) + ')'
        age = str(max(0, int(time.time() - (row.get('since') or time.time())))) + 's'
        location = str(row.get('window', '-')) + '.' + str(row.get('pane', '-'))
        print('  ' + location + ' ' + name + '  ' + row['kind'] + '  ' + state + ' ' + age + '  ' + clean(short_path(row['cwd']), 60) + (' · ' + clean(row['title'], 50) if row.get('title') else ''))
    if hidden:
        groups = collections.Counter(r['host'] + ' ' + r.get('group', 'Other') for r in hidden)
        print(' · '.join(g + ' ' + str(n) + ' agents' for g, n in groups.items()) + ' — tandem --all')
    if errors:
        print('Unavailable: ' + '; '.join(errors), file=sys.stderr)
    if not rows:
        print('No matching agents. Install tandem-hook or use tandem spawn.')


SETTLE = 4  # seconds say waits so its one line already tells where the message went


def settled(owner, ident, result):
    """Follow the receipt past queued/sending. Without this say printed "queued · mailbox" nearly
    every time and the sender had to call tandem receipt to learn anything."""
    end = time.monotonic() + SETTLE
    while result.get('stage') in ('queued', 'sending') and time.monotonic() < end:
        time.sleep(.3)
        try:
            result = dispatch(owner, {'op': 'receipt', 'id': ident})
        except (ValueError, OSError, subprocess.SubprocessError):
            break
    return result


def answered_in_place(target, ident):
    """What the agent said when it finished the turn our question started, or None while that turn is not over.

    An agent often answers in its own conversation and forgets `tandem say`. The asker would wait out the clock
    for a reply that already exists, so once the turn has ended, its last message is the answer."""
    row, rec = session(target['id']), receipt(ident)
    # The turn must have ended after the question landed: a Stop that only handed the question over does not count.
    if not row or rec.get('stage') != 'delivered' or (row.get('turn_ok_at') or 0) <= (rec.get('delivered') or float('inf')) \
            or public(row)['state'] != 'idle':
        return None
    from tandem_history import history
    try:
        return (history(row, 1)['messages'] or [''])[-1]
    except (ValueError, OSError):
        return ''


def say(name, body, ask=False, timeout=30):
    sender = me()
    target = resolve(name)
    ident = secrets.token_hex(12)
    outgoing = dict(id=ident, sender=sender['id'], recipient=target['id'], host=target['host'], name=target['name'], created=time.time(), ask=ask)
    # A plain reply needs no re:id. Link to the newest delivered message from
    # that session; parallel unrelated conversations should use separate agents.
    pending = [read(p) for p in (root() / 'receipts').glob('*.json')]
    pending = [r for r in pending if r.get('recipient') == sender['id'] and r.get('sender', {}).get('id') == target['id']
               and r.get('sender', {}).get('host') == target['host'] and r.get('stage') == 'delivered']
    reply_to = max(pending, key=lambda r: r['created'])['id'] if pending else None
    write(path('outgoing', ident), outgoing)
    waiting_path = path('waiting', sender['id'])
    if ask:
        with lock(waiting_path):
            previous = read(waiting_path)
            if previous.get('until', 0) > time.time() and alive(previous):
                raise ValueError('this session already has an active ask; finish it before asking again')
            write(waiting_path, dict(message=ident, tandem_id=target['id'], tandem_host=target['host'], name=target['name'],
                                     since=time.time(), until=time.time() + timeout, process=process(os.getpid())))
    request = dict(op='receive', id=ident, recipient=target['id'], body=body, ask=ask, reply_to=reply_to,
                   sender=dict({k: sender[k] for k in ('id', 'name', 'host')},
                               mode=permission_mode((sender.get('process') or {}).get('pid', 0))))
    try:
        result = dispatch(target['host'], request)
        if reply_to:
            try:
                update_receipt(reply_to, stage='replied', reply=ident)
            except TimeoutError:
                pass  # the message is out: a missed link must not read as a failed send and invite a second one
        with lock(root() / 'contacts.json'):
            contacts = read(root() / 'contacts.json')
            contacts[target['host'] + '/' + target['id']] = time.time()
            write(root() / 'contacts.json', contacts)
        result['owner'] = target['host']
        if not ask:
            return dict(settled(target['host'], ident, result), owner=target['host'])
        end = time.monotonic() + timeout
        look = ended = 0
        while time.monotonic() < end:
            answer_path = path('answers', ident)
            answer = read(answer_path)
            if answer:
                answer_path.unlink()
                return dict(id=ident, stage='replied', from_agent=target['name'], answer=answer['body'])
            if target['host'] == host() and time.monotonic() >= look:
                look = time.monotonic() + 1
                said = answered_in_place(target, ident)
                if said is None:
                    ended = 0
                elif not ended:
                    ended = time.monotonic()  # a reply sent in its last moment may still be on its way
                elif time.monotonic() - ended > 2 and said:
                    return dict(id=ident, stage='replied', from_agent=target['name'],
                                answer='[%s ended its turn without `tandem say`; its last message:]\n%s' % (target['name'], said))
            time.sleep(.1)
        return dict(id=ident, stage='timeout', owner=target['host'], reason='question remains sent; late reply arrives normally')
    finally:
        if ask and read(waiting_path).get('message') == ident:
            waiting_path.unlink(missing_ok=True)


def main(argv):
    if argv and argv[0] == '_rpc':
        print(json.dumps(rpc(json.loads(argv[2]), argv[1])))
        return
    if argv and argv[0] == '_work':
        work('--once' in argv)
        return
    as_json = '--json' in argv
    argv = [a for a in argv if a != '--json']
    if argv and argv[0] in ('install', 'uninstall'):
        from tandem_setup import install
        return install(argv)
    if argv and argv[0] == 'doctor':
        from tandem_setup import doctor
        sys.exit(doctor(argv))
    if os.name == 'nt' and argv and argv[0] == 'run':
        # exec on Windows starts a second process and lets go of the console; stay and pass the exit code on.
        sys.exit(subprocess.run([sys.executable, str(BIN / 'tandem-session')] + argv[1:]).returncode)
    if argv and argv[0] == 'run':
        os.execv(sys.executable, [sys.executable, str(BIN / 'tandem-session')] + argv[1:])
    if argv and argv[0] == 'models':
        from tandem_spawn import models
        result = models()
    elif not argv or argv[0] == '--all' or argv[0] not in ('say', 'ask', 'wait', 'me', 'name', 'read', 'receipt', 'spawn', '-h', '--help'):
        result = list_agents(' '.join(argv) if argv and argv[0] != '--all' else '', '--all' in argv, as_json)
    elif argv[0] in ('-h', '--help'):
        print('''tandem — talk to your other coding agents by name

  tandem [search] [--all]              who is near you, what each is doing (--all: everyone)
  tandem say NAME "text"               send; prints where it went (delivered / queued / held)
  tandem say NAME --file PATH          the same, text from a UTF-8 file (quotes and newlines arrive intact)
  tandem ask NAME "question"           wait and print their reply (30s; --timeout up to 3600)
  tandem read NAME [--last 3]          their last answers, from the engine's own history
  tandem wait NAME [--until idle]      wait for a state
  tandem me | tandem name NEW            who you are / rename yourself (kept across resume)
  tandem receipt HOST/ID               where a message stopped
  tandem spawn NAME --kind claude|codex [--cwd DIR] [--host HOST] [--model M] [--effort E]
             [--prompt-file PATH] [-- ARGS]
                                     start an agent; PATH holds its first task, ARGS go to the engine
  tandem models                        models and effort levels spawn accepts
  tandem run codex [ARGS]              start Codex so tandem can reach it
  tandem install [--accept-inbound] [--codex-alias]
                                     hook into Claude Code and Codex (tandem doctor explains both)
  tandem doctor                        what works, what is missing, how to fix it

Messages go through each engine's own input path, never your terminal:
a draft you are typing stays intact and an approval prompt never gets an Enter.
NAME@HOST picks a machine. An exact id or session ID also works (see tandem --all --json).
One live namesake wins over stopped sessions. Add --json for scripts.''')
        return
    elif argv[0] == 'me':
        result = public(me())
    elif argv[0] == 'name':
        if len(argv) != 2:
            raise ValueError('usage: tandem name NAME')
        current = me()
        name = claim_name(current['id'], argv[1], explicit=True)
        with lock(path('sessions', current['id'])):
            current = session(current['id']);current['name'] = name;current['named'] = True
            write(path('sessions', current['id']), current)
        result = public(current)
    elif argv[0] in ('say', 'ask'):
        parser = argparse.ArgumentParser(prog='tandem ' + argv[0])
        parser.add_argument('name');parser.add_argument('text', nargs='?');parser.add_argument('--timeout', type=float, default=30)
        # A shell can mangle quotes, newlines and non-ASCII on the way in (cmd and PowerShell do); a file cannot.
        parser.add_argument('--file', help='read the text from this UTF-8 file instead')
        args = parser.parse_args(argv[1:])
        # Long waits are for a command the agent runs in the background: it is told the moment the answer is in.
        if not 0 < args.timeout <= 3600:
            raise ValueError('timeout must be in (0, 3600] seconds')
        if (args.text is None) == (args.file is None):
            raise ValueError('give the text, or --file PATH with the text in it')
        text = args.text if args.file is None else Path(args.file).read_text(encoding='utf-8-sig').strip()
        result = say(args.name, text, argv[0] == 'ask', args.timeout)
    elif argv[0] == 'receipt':
        owner, ident = argv[1].split('/', 1)
        result = dict(dispatch(owner, {'op': 'receipt', 'id': ident}), owner=owner)
    elif argv[0] == 'read':
        parser = argparse.ArgumentParser(prog='tandem read')
        parser.add_argument('name');parser.add_argument('--last', type=int, default=3)
        args = parser.parse_args(argv[1:])
        row = resolve(args.name);result = dispatch(row['host'], {'op': 'read', 'session': row['id'], 'last':args.last})
    elif argv[0] == 'wait':
        parser = argparse.ArgumentParser(prog='tandem wait')
        parser.add_argument('name');parser.add_argument('--until', default='idle');parser.add_argument('--timeout', type=float, default=30)
        args = parser.parse_args(argv[1:])
        if not 0 < args.timeout <= 3600:
            raise ValueError('timeout must be in (0, 3600] seconds')
        target = resolve(args.name)
        end = time.monotonic() + args.timeout
        while True:
            rows = dispatch(target['host'], {'op': 'list'})['agents']
            row = next(r for r in rows if r['id'] == target['id'])
            if row['state'] == args.until or time.monotonic() >= end:
                result = dict(agent=row, reached=row['state'] == args.until);break
            time.sleep(.5)
    else:
        from tandem_spawn import spawn
        result = spawn(argv[1:])
    if result is not None:
        if as_json:
            print(json.dumps(result, ensure_ascii=False))
        elif 'answer' in result:
            print(result['answer'])
        elif 'stage' in result:
            print(result['stage'] + ' · ' + str(result.get('route') or 'mailbox') + ' · ' + str(result.get('owner') or host()) + '/' + result['id']
                  + (' · ' + result['reason'] if result.get('reason') else ''))
        elif 'text' in result:
            print(result['text'], end='')
        else:
            print(json.dumps(result, ensure_ascii=False))


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except (ValueError, OSError, TimeoutError, subprocess.SubprocessError) as error:
        sys.exit('tandem: ' + str(error))
